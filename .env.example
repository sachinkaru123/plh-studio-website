# Absolute origin used for metadataBase, canonical URLs, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://plhconnect.com

# Third-party form endpoint (Web3Forms / Formspree / Getform).
# The site is a static export, so there is no server to receive submissions.
# Leave unset and the contact form degrades to a prefilled mailto: link.
NEXT_PUBLIC_CONTACT_ENDPOINT=
